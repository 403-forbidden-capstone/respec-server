# Re:Spec 서버 환경 변수 이름 목록. 값은 깃에 없음 — 서버의 /srv/respec/*.env 에만 있음.
#
# 읽는 법
#   `# === 파일이름 ===` 줄부터 다음 `# === ===` 줄까지가 그 서버 파일(api.env · ml.env · deploy.env · smoke.env)의 이름 목록.
#   바로 위 줄이 `# optional` 이면 값이 비어 있어도 됨. 없으면 값이 꼭 있어야 함(배포 전 점검이 막음).
#   서버에서 `check-env.sh`가 이 목록과 실제 파일의 이름을 비교함(값은 출력 안 함).
# 새 이름이 필요하면 PR 설명에 적고, 이 파일은 deploy 주인(AWS 세션)이 반영함.
#
# compose가 컨테이너에 직접 넣는 값(API_TAG → APP_VERSION · CATBOOST_MODEL_DIR · PORT)은 여기 없음.

# === api.env ===
# api · scheduler 컨테이너가 읽음 (권한 600)

# Supabase 프로젝트 주소 · 공개 키 (비밀 아님)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 관리자 키 — 대시보드 Secret keys 에서 새로 발급한 것. 옛 service_role 키 재사용 금지
SUPABASE_SECRET_KEY=
# 카카오 로컬 · 길찾기 REST 키 (장소 함수, 1차)
KAKAO_REST_API_KEY=
# optional
# Expo 푸시 접근 토큰 (선택값, 3차 푸시 모듈)
EXPO_ACCESS_TOKEN=
# optional
# 풀러 세션 모드 접속 문자열 — DB 접근 방식 B 를 고를 때만 (정할 일 0-7, 2차)
DATABASE_URL=
# optional
# 예측 서버 주소: 서버 안 주소 http://prepare-ml:8091 (끝에 /predict 안 붙임, 2차 2-4)
PREPARE_ML_URL=
# optional
# 예측 서버 토큰 — ml.env 의 CATBOOST_API_TOKEN 과 같은 값 (2차 2-4)
PREPARE_ML_API_TOKEN=
# optional
# /health/deep 결과를 앱 안에서 재사용하는 초 (기본 5, FastAPI S1b)
HEALTH_DEEP_CACHE_SECONDS=

# === ml.env ===
# prepare-ml 컨테이너가 읽음 (권한 600). Supabase 키 없음

# 예측 서버가 받는 토큰 (헤더 x-api-key). 공통 서버용 새로 발급: openssl rand -hex 32
CATBOOST_API_TOKEN=

# === deploy.env ===
# 배포 스크립트가 읽고 compose 가 변수 치환에 씀 (권한 600). 값은 영문 · 숫자 · . _ , - 만.
# API_TAG · LAST_GOOD_API_TAG 는 deploy.sh 가 씀 — 사람이 안 건드림

# optional
# 지금 돌리는 api 이미지 태그 (sha-<커밋>) — deploy.sh 가 관리, 첫 배포 전엔 비어 있음
API_TAG=
# optional
# 마지막으로 배포 직후 점검까지 통과한 api 이미지 태그 — deploy.sh 가 관리, 첫 배포 전엔 비어 있음
LAST_GOOD_API_TAG=
# optional
# 켤 compose 프로필. 예측 서버를 켜면 ml (1-11 이후), 아직이면 비움
COMPOSE_PROFILES=

# === smoke.env ===
# 배포 직후 점검(smoke.sh)만 읽음 (권한 600). compose 는 이 파일을 안 읽음 — 비밀번호의 $ · 공백 · 따옴표가 compose 변수 해석을 깨뜨리지 않게 분리함.
# 형식: NAME=값 (줄 끝까지가 값, 따옴표로 감싸지 않음)

# 점검이 시험 계정으로 로그인할 Supabase 주소 · 공개 키 (api.env 와 같은 값)
SMOKE_SUPABASE_URL=
SMOKE_SUPABASE_PUBLISHABLE_KEY=
# 점검용 시험 계정 (실사용자 아님, 지형님이 Supabase 에서 만든 것)
SMOKE_EMAIL=
SMOKE_PASSWORD=

# === end ===
